{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "api-test": {
      "dependsOn": ["build"]
    },
    "e2e": {
      "dependsOn": ["build", "api#build"]
    },
    "openapi": {
      "dependsOn": ["build"],
      "outputs": ["../../packages/api-client/openapi.json"]
    },
    "generate": {
      "dependsOn": ["api#openapi"],
      "outputs": ["src/schema.ts"]
    },
    "@reference/api-client#build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**"]
    }
  }
}
