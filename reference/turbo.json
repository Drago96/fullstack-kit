{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": ["API_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": {},
    "api-test": { "dependsOn": ["build"], "passThroughEnv": ["DATABASE_URL"] },
    "e2e": {
      "dependsOn": ["build", "api#build"],
      "passThroughEnv": ["CI", "DATABASE_URL"]
    },
    "openapi": { "dependsOn": ["build"], "outputs": ["openapi.json"] },
    "generate": {
      "dependsOn": ["api#openapi"],
      "inputs": ["../../apps/api/openapi.json"],
      "outputs": ["src/schema.ts"]
    },
    "@reference/api-client#build": { "dependsOn": ["generate", "^build"], "outputs": ["dist/**"] }
  }
}
