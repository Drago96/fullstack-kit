# Port the API listens on. Cloud Run sets this itself.
PORT=3001
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Postgres connection string. `docker compose up -d postgres` serves this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Sentry project DSN. Leave unset to run without error reporting.
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# Which provider POST /ask talks to: google | mock. mock needs no key or network.
LLM_PROVIDER=mock
# Required when LLM_PROVIDER=google. https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=
