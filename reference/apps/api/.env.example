# Port the API listens on. Cloud Run sets this itself.
PORT=3001
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Postgres connection string. `docker compose up -d postgres` serves this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Sentry project DSN. Leave unset to run without error reporting.
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# Which provider POST /ask talks to: google | mock. mock needs no key or network.
LLM_PROVIDER=mock
# Required when LLM_PROVIDER=google. https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=
# Public base URL of this API, used to build the links in the emails it sends.
API_URL=http://localhost:3001
# Public base URL of the web app: the trusted origin for auth requests, and where
# verification and password-reset links send the visitor back to.
WEB_URL=http://localhost:3000
# Signs sessions and verification tokens, at least 32 characters. `openssl rand -hex 32`.
AUTH_SECRET=development-secret-change-me-at-least-32-chars
# resend | capture. capture keeps messages in memory and serves them from
# GET /debug/emails instead of sending them, which is what local runs and CI want.
EMAIL_TRANSPORT=capture
# Sender of every message. Resend's onboarding@resend.dev works without a verified domain.
# EMAIL_FROM=Reference <onboarding@resend.dev>
# Required when EMAIL_TRANSPORT=resend. https://resend.com/api-keys
# RESEND_API_KEY=
